# SPDX-FileCopyrightText: 2021-present Arcade Data Ltd (info@arcadedata.com)
# SPDX-License-Identifier: Apache-2.0
#
# Docker build for ArcadeDB Python package
# Builds arcadedb package with bundled JRE (no external Java required)
# Excludes JARs listed in scripts/jar_exclusions.txt to optimize size
#
# REQUIRED BUILD ARGS (passed from build.sh):
#   PYTHON_VERSION - Python version for wheel (e.g., 3.11, 3.12, 3.13, 3.14)
#   PACKAGE_NAME - always: arcadedb-jvm
#   PACKAGE_DESCRIPTION - package description
#   TARGET_PLATFORM - Linux target platform for bundled JRE (linux-x64, linux-arm64)

ARG PYTHON_VERSION=3.12
ARG PACKAGE_NAME=arcadedb-jvm
ARG PACKAGE_DESCRIPTION="ArcadeDB embedded multi-model database with bundled JRE - no Java installation required"
# Deterministic placeholder. The wrapper build script must pass the real ArcadeDB tag.
ARG ARCADEDB_TAG=build-arg-required
ARG TARGET_PLATFORM=linux-x64
# When set to 1, prefer jars provided in local-jars/lib from the build context.
# If no local jars are present, the build fails fast to avoid silently falling back.
ARG USE_LOCAL_JARS=0
ARG LOCAL_JARS_HASH=none

# Stage 1: Use prebuilt ArcadeDB image to obtain compiled JARs
# JARs are filtered based on scripts/jar_exclusions.txt in later stages
FROM arcadedata/arcadedb:${ARCADEDB_TAG} AS java-builder

# nothing to do here; jars will be copied from /home/arcadedb/lib in the python-builder stage

# Stage 2: Build minimal JRE with jlink
# Docker builds are Linux-only. macOS/Windows JREs must be created on matching native hosts.
#
# The JDK is Eclipse Temurin, not amazoncorretto:25. The Corretto IMAGE is Amazon Linux 2023 (glibc 2.34) and its JDK is
# built against it: every binary needs GLIBC_2.34, which is what set the wheels' manylinux_2_34 floor. Temurin's Linux
# JDK builds need glibc 2.17 at most on x86_64 and aarch64 (scripts/verify_wheel_platform_tag.py --jre prints
# manylinux_2_17 for both), and the eclipse-temurin image carries that build unchanged. jlink copies the libraries of the
# JDK it runs, so the bundled JRE has the same floor. Both are GPLv2 with the Classpath Exception.
FROM eclipse-temurin:25-jdk AS jre-builder

# Install required tooling (findutils for jar exclusion, binutils for jlink)
RUN apt-get update && apt-get install -y --no-install-recommends findutils binutils \
    && rm -rf /var/lib/apt/lists/*

ARG TARGET_PLATFORM
ARG USE_LOCAL_JARS
ARG LOCAL_JARS_HASH

RUN case "$TARGET_PLATFORM" in \
        linux-x64|linux-arm64) ;; \
        *) echo "❌ Dockerfile.build only supports Linux TARGET_PLATFORM values (got: $TARGET_PLATFORM)" && exit 1 ;; \
    esac

WORKDIR /build

# Stash upstream jars from the ArcadeDB image
RUN mkdir -p /build/upstream-jars /build/jars /build/local-jars
COPY --from=java-builder /home/arcadedb/lib /build/upstream-jars/

# Optionally bring in locally built jars from the repo (local-jars/lib)
COPY local-jars/lib/ /build/local-jars/

# Make local-jar content changes part of Docker's cache key for this stage.
RUN echo "LOCAL_JARS_HASH=${LOCAL_JARS_HASH}"

# Select jar source: local when requested and available; otherwise fall back to upstream image
RUN if [ "$USE_LOCAL_JARS" = "1" ]; then \
            if [ -d /build/local-jars ] && [ "$(ls -1 /build/local-jars | wc -l)" -gt 0 ]; then \
                echo "📦 Using local jars from build context" && cp /build/local-jars/* /build/jars/; \
            else \
                echo "❌ USE_LOCAL_JARS=1 but no jars found in local-jars/lib" && exit 1; \
            fi; \
        else \
            echo "📦 Using ArcadeDB image jars" && cp /build/upstream-jars/* /build/jars/; \
        fi

# Copy JAR exclusion list
COPY scripts/jar_exclusions.txt /build/jar_exclusions.txt
# JDK modules the bundled JRE must not contain (see the file for why)
COPY scripts/jre_module_exclusions.txt /build/jre_module_exclusions.txt

# Remove excluded JARs based on jar_exclusions.txt
RUN echo "🗑️  Removing excluded JARs..." && \
    echo "📋 JAR count before exclusion: $(ls -1 /build/jars/*.jar | wc -l)" && \
    while IFS= read -r pattern; do \
        # Skip empty lines and comments
        if [ -n "$pattern" ] && [ "${pattern#\#}" = "$pattern" ]; then \
            echo "   Processing pattern: $pattern" && \
            # Use find and delete to show what's being removed
            find /build/jars -name "$pattern" -type f -exec echo "   - Removing: {}" \; -delete; \
        fi \
    done < /build/jar_exclusions.txt && \
    echo "📋 JAR count after exclusion: $(ls -1 /build/jars/*.jar | wc -l)"

# Build the Python-bindings bridge jar (batched row transport; see
# src/java/com/arcadedb/python/RowBatcher.java)
COPY src/java /build/bridge-src
RUN echo "🔨 Building arcadedb-python-bridge.jar..." && \
    mkdir -p /build/bridge-classes && \
    javac -cp "/build/jars/*" -d /build/bridge-classes \
        $(find /build/bridge-src -name "*.java") && \
    jar cf /build/jars/arcadedb-python-bridge.jar -C /build/bridge-classes . && \
    echo "✅ Bridge jar built: $(ls -la /build/jars/arcadedb-python-bridge.jar)"

# Build minimal JRE with jlink
# Automatically detect modules with jdeps, plus ensure jdk.zipfs (for JPype) and jdk.unsupported are included
# We exclude jboss/wildfly JARs because they have broken module descriptors that fail analysis.
# We also do NOT provide a classpath, forcing jdeps to ignore all missing dependencies (intra-jar or external).
RUN echo "🔍 Analyzing JARs with jdeps..." && \
    JMODS_DIR="${JAVA_HOME}/jmods" && \
    if [ ! -d "$JMODS_DIR" ]; then JMODS_DIR="${JAVA_HOME}/lib/jmods"; fi && \
    DETECTED_MODULES=$(find /build/jars -name "*.jar" | grep -v "jboss" | grep -v "wildfly" | grep -v "smallrye" | grep -v "spatial-extras" | xargs jdeps --print-module-deps --ignore-missing-deps --multi-release 25 2>&1 | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -E '^[a-zA-Z0-9_.]+$' | sort -u | paste -sd "," -) && \
    if [ -d "$JMODS_DIR" ]; then \
        AVAILABLE_MODULES=$(find "$JMODS_DIR" -name "*.jmod" -printf "%f\n" | sed 's/\.jmod$//' | sort -u | paste -sd "|" -) ; \
        FILTERED_MODULES=$(echo "${DETECTED_MODULES}" | tr ',' '\n' | sed '/^$/d' | grep -E "^(${AVAILABLE_MODULES})$" | sort -u | paste -sd "," -) ; \
    else \
        FILTERED_MODULES="${DETECTED_MODULES}" ; \
    fi && \
    grep -v '^#' /build/jre_module_exclusions.txt | tr -d '\r' | sed '/^[[:space:]]*$/d' > /build/jre_excluded_modules.list && \
    echo "📦 Excluded modules: $(paste -sd ',' /build/jre_excluded_modules.list)" && \
    FILTERED_MODULES=$(echo "${FILTERED_MODULES}" | tr ',' '\n' | sed '/^$/d' | grep -vxFf /build/jre_excluded_modules.list | paste -sd "," -) && \
    if [ -z "${FILTERED_MODULES}" ]; then \
        echo "❌ jdeps found no modules; the java.se fallback would bring back the excluded modules, so the build stops" && \
        exit 1 ; \
    fi && \
    REQUIRED_MODULES="${FILTERED_MODULES},jdk.management,jdk.zipfs,jdk.unsupported,jdk.incubator.vector" && \
    echo "🔨 Building minimal JRE for platform: ${TARGET_PLATFORM}" && \
    echo "📦 Detected modules (raw): ${DETECTED_MODULES}" && \
    echo "📦 Detected modules (filtered): ${FILTERED_MODULES}" && \
    echo "📦 Final modules list: ${REQUIRED_MODULES}" && \
    echo "📦 Required modules:" && \
    echo "$REQUIRED_MODULES" | tr ',' '\n' | sed 's/^/   - /' && \
    if [ -d "$JMODS_DIR" ]; then \
        echo "" ; \
        echo "🔨 Running jlink..." ; \
        if ! jlink \
            --module-path "$JMODS_DIR" \
            --add-modules "${REQUIRED_MODULES}" \
            --ignore-signing-information \
            --strip-debug \
            --no-man-pages \
            --no-header-files \
            --compress zip-9 \
            --output /build/jre ; then \
            echo "❌ jlink failed" ; \
            exit 1 ; \
        fi ; \
        echo "" ; \
        echo "✅ JRE build complete!" ; \
        echo "📊 JRE size after jlink: $(du -sm /build/jre | cut -f1) MB" ; \
        BAD_MODULES=$(/build/jre/bin/java --list-modules | sed 's/@.*//' | grep -xFf /build/jre_excluded_modules.list || true) ; \
        if [ -n "$BAD_MODULES" ]; then \
            echo "❌ the JRE contains excluded modules (another module requires them): $BAD_MODULES" ; \
            exit 1 ; \
        fi ; \
        echo "✅ No excluded module in the JRE" ; \
        find /build/jre -name '*.so' -type f -exec strip --strip-unneeded {} + ; \
        echo "📊 JRE size after stripping native libraries: $(du -sm /build/jre | cut -f1) MB" ; \
    else \
        echo "⚠️  jmods directory not found under ${JAVA_HOME}. Falling back to copying full JDK runtime." ; \
        mkdir -p /build/jre ; \
        cp -a ${JAVA_HOME}/bin /build/jre/bin ; \
        cp -a ${JAVA_HOME}/lib /build/jre/lib ; \
        cp -a ${JAVA_HOME}/conf /build/jre/conf || true ; \
        cp -a ${JAVA_HOME}/release /build/jre/release || true ; \
        echo "✅ Fallback JRE created from full JDK runtime." ; \
    fi && \
    echo "" && \
    JRE_SIZE=$(du -sh /build/jre | cut -f1) && \
    echo "📊 JRE size: $JRE_SIZE" && \
    echo "" && \
    echo "🧪 Testing JRE..." && \
    /build/jre/bin/java -version && \
    echo "" && \
    echo "✅ JRE is functional!" && \
    if [ ! -f /build/jre/bin/java ]; then \
        echo "❌ ERROR: JRE build failed - java executable not found!"; \
        exit 1; \
    fi

# Stage 3: Build Python wheel

FROM python:${PYTHON_VERSION}-slim AS python-builder

# Install minimal build tooling (no external JDK needed; we use bundled JRE)
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for faster, deterministic installs
ENV PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && uv --version

WORKDIR /build

# Copy filtered JARs from jre-builder (already has exclusions applied)
COPY --from=jre-builder /build/jars /build/jars/

# Copy JRE from jre-builder stage
COPY --from=jre-builder /build/jre /build/jre/

# Copy Python bindings source
COPY src ./src
COPY tests ./tests
COPY setup.py .
COPY scripts/setup_jars.py ./scripts/
COPY scripts/extract_version.py ./scripts/
COPY scripts/write_version.py ./scripts/
COPY scripts/verify_wheel_platform_tag.py ./scripts/
COPY pyproject.toml ./
COPY README.md ./


# Install Python build dependencies
# No jpype1: setup.py never imports it, and a Python without a JPype wheel (3.15, until JPype > 1.7.1) would compile it
RUN uv pip install --system build wheel setuptools

# Re-declare build args for this stage (required after FROM)
ARG PACKAGE_NAME
ARG PACKAGE_DESCRIPTION
ARG ARCADEDB_TAG
ARG TARGET_PLATFORM

# Extract version and copy JARs (including JRE)
# Version is passed from build.sh via ARCADEDB_TAG build arg
RUN echo "📌 Package name: ${PACKAGE_NAME}" && \
    echo "📌 Docker tag used: ${ARCADEDB_TAG}" && \
    echo "📌 Target platform: ${TARGET_PLATFORM}" && \
    python3 scripts/write_version.py /build/jars && \
    python3 scripts/setup_jars.py && \
    echo "📦 JAR files and JRE copied"

# Build the wheel
# Extract PEP 440 version from the engine jar or use BUILD_VERSION if provided.
#
# Wheel platform tag: manylinux_2_28, the same floor as the native wheels (glibc 2.28: RHEL, Rocky and
# AlmaLinux 8, Debian 10, Ubuntu 20.04 and newer). It is also the lowest the Python side can have: JPype's own Linux
# wheels are manylinux_2_28. The tag is the higher of that floor and the highest GLIBC_ symbol the bundled JRE
# references (2.17 with Temurin). Tagging higher than that locks out systems the wheel runs on (issue #4037: a
# manylinux_2_35 tag on a JRE that needed 2.34); tagging lower lets it install where the JRE cannot run. The
# verify_wheel_platform_tag.py step below enforces both at build time, and test-jvm.yml installs the built wheel in
# a manylinux_2_28 container.
ARG BUILD_VERSION=""
RUN if [ -n "${BUILD_VERSION}" ]; then \
        export ARCADEDB_VERSION="${BUILD_VERSION}"; \
        echo "📌 Using provided version: ${ARCADEDB_VERSION}"; \
    else \
        export ARCADEDB_VERSION=$(python3 scripts/extract_version.py --format=pep440 /build/jars); \
        echo "📦 Extracted version from engine jar: ${ARCADEDB_VERSION}"; \
    fi && \
    echo "📦 Python package version: ${ARCADEDB_VERSION}" && \
    echo "📦 Package name: ${PACKAGE_NAME}" && \
    echo "📦 Package description: ${PACKAGE_DESCRIPTION}" && \
    sed -i 's|^name = .*|name = "'"${PACKAGE_NAME}"'"|' pyproject.toml && \
    sed -i 's|^version = .*|version = "'"${ARCADEDB_VERSION}"'"|' pyproject.toml && \
    sed -i 's|^description = .*|description = "'"${PACKAGE_DESCRIPTION}"'"|' pyproject.toml && \
    if echo "${TARGET_PLATFORM}" | grep -q '^linux-'; then \
        if [ "${TARGET_PLATFORM}" = "linux-x64" ]; then \
            WHEEL_PLAT="manylinux_2_28_x86_64"; \
        elif [ "${TARGET_PLATFORM}" = "linux-arm64" ]; then \
            WHEEL_PLAT="manylinux_2_28_aarch64"; \
        else \
            WHEEL_PLAT=""; \
        fi; \
        if [ -n "${WHEEL_PLAT}" ]; then \
            echo "🏷️  Building wheel with platform tag: ${WHEEL_PLAT}"; \
            python3 -m build --wheel --config-setting=--build-option=--plat-name=${WHEEL_PLAT}; \
        else \
            python3 -m build --wheel; \
        fi; \
    else \
        python3 -m build --wheel; \
    fi && \
    if echo "${TARGET_PLATFORM}" | grep -q '^linux-'; then \
        if [ -n "${WHEEL_PLAT}" ] && ! ls /build/dist/*${WHEEL_PLAT}*.whl 1> /dev/null 2>&1; then \
            echo "❌ Expected manylinux wheel (${WHEEL_PLAT}) not found"; \
            ls -lh /build/dist; \
            exit 1; \
        fi; \
        WHEEL_FILE=$(ls /build/dist/*.whl | head -n1); \
        if [ -n "${WHEEL_FILE}" ]; then \
            python3 scripts/verify_wheel_platform_tag.py "${WHEEL_FILE}" /build/jre || exit 1; \
        fi; \
    fi && \
    echo "✅ Wheel built successfully!" && \
    ls -lh dist/

# Stage 4: Export stage (for extracting wheels)
FROM python-builder AS export
# This stage exists to provide a stable location for wheel extraction
# The dist directory is preserved from python-builder stage

# Stage 5: Test the built wheel
FROM python:${PYTHON_VERSION}-slim AS tester

# No external JRE needed in tester; the wheel includes a bundled JRE
# Keep build-essential in case pytest or wheels need compilation on some platforms
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for faster, deterministic installs
ENV PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && uv --version

WORKDIR /test

# Copy the wheel from builder
COPY --from=python-builder /build/dist/*.whl /tmp/

# Install the wheel and test dependencies
RUN uv pip install --system /tmp/*.whl pytest pytest-cov

# Copy tests
COPY --from=python-builder /build/tests ./tests/

# Create a quick installation test
RUN echo '#!/usr/bin/env python3\n\
import arcadedb\n\
import tempfile\n\
import shutil\n\
import os\n\
\n\
print("🎮 Testing ArcadeDB Python bindings...")\n\
print(f"📦 Version: {arcadedb.__version__}")\n\
\n\
temp_dir = tempfile.mkdtemp()\n\
db_path = os.path.join(temp_dir, "test_db")\n\
\n\
try:\n\
    with arcadedb.create_database(db_path) as db:\n\
        print("✅ Database created")\n\
        \n\
        with db.transaction():\n\
            db.command("sql", "CREATE DOCUMENT TYPE TestDoc")\n\
            db.command("sql", "INSERT INTO TestDoc SET name = '\''docker_test'\'', value = 123")\n\
        print("✅ Transaction committed")\n\
        \n\
        result = db.query("sql", "SELECT FROM TestDoc")\n\
        for record in result:\n\
            print(f"✅ Query result: {record.get('\''name'\'')} = {record.get('\''value'\'')}")\n\
    \n\
    print("🎉 All tests passed!")\n\
finally:\n\
    if os.path.exists(temp_dir):\n\
        shutil.rmtree(temp_dir)\n\
' > /test/test_install.py && chmod +x /test/test_install.py

# Run the installation test
RUN python3 /test/test_install.py

CMD ["python3", "/test/test_install.py"]
